# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma sqlite db
/prisma/dev.db
/prisma/dev.db-journal

# uploaded images (local filesystem storage for MVP)
/public/uploads/*
!/public/uploads/.gitkeep

# prisma resolves relative sqlite paths from prisma/, so the db actually lands here
/prisma/prisma/

# auto-installed skill bundles (not project source)
/.agents/
/.claude/
/.windsurf/
skills-lock.json
